digraph ui_flow {
  graph [rankdir=LR, bgcolor="#0b1020", pad="0.25", nodesep="0.35", ranksep="0.65", fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#182235", color="#7dd3fc", fontcolor="#f8fafc", fontname="Arial", fontsize=11, margin="0.14,0.09"];
  edge [color="#9fb0c8", fontcolor="#dce7f5", fontname="Arial", fontsize=9, arrowsize=0.7];
  label="Internal tools, settings, and Bluetooth"; labelloc=t; fontsize=19; fontcolor="#ffffff";
  shell [label="Persistent tab shell"];
  internal [label="Internal tools"];
  adhoc [label="Ad Hoc Portal & Karma"];
  settings [label="Settings"];
  scan_cfg [label="Scan Setup popup"];
  red [label="Red Team page / disclaimer"];
  timeout [label="Screen Timeout popup"];
  brightness [label="Screen Brightness popup"];
  rotation [label="Screen Rotation popup"];
  theme [label="Theme popup"];
  time [label="Time popup"];
  lock [label="Screen Lock popup"];
  ota [label="Monster OTA page / modals"];
  sdadmin [label="Monster SD Admin / leave dialog"];
  baud [label="Transfer Speed popup"];
  home [label="Transport dashboard"];
  bt [label="Bluetooth menu"];
  airtag [label="AirTag Scan"];
  btscan [label="BT Scan & Locate"];
  locator [label="BT Locator"];
  jammer [label="2.4 GHz Jammer"];
  shell -> internal [label="tap Internal tab", color="#1677c8", style="solid"];
  internal -> settings [label="tap Settings", color="#1677c8", style="solid"];
  internal -> adhoc [label="tap Ad Hoc Portal & Karma", color="#1677c8", style="solid"];
  settings -> scan_cfg [label="tap Scan Setup", color="#1677c8", style="solid"];
  settings -> red [label="tap Red Team", color="#1677c8", style="solid"];
  settings -> timeout [label="tap Screen Timeout", color="#1677c8", style="solid"];
  settings -> brightness [label="tap Screen Brightness", color="#1677c8", style="solid"];
  settings -> rotation [label="tap Screen Rotation", color="#1677c8", style="solid"];
  settings -> theme [label="tap Theme", color="#1677c8", style="solid"];
  settings -> time [label="tap Time", color="#1677c8", style="solid"];
  settings -> lock [label="tap Screen Lock", color="#1677c8", style="solid"];
  settings -> ota [label="tap Monster OTA", color="#1677c8", style="solid"];
  settings -> sdadmin [label="tap Monster SD Admin", color="#1677c8", style="solid"];
  settings -> baud [label="tap Transfer Speed", color="#1677c8", style="solid"];
  home -> bt [label="tap Bluetooth", color="#1677c8", style="solid"];
  bt -> airtag [label="tap AirTag Scan", color="#1677c8", style="solid"];
  bt -> btscan [label="tap BT Scan & Locate", color="#1677c8", style="solid"];
  bt -> jammer [label="tap Jammer; Red Team tile only", color="#b26a00", style="dashed"];
  btscan -> locator [label="tap discovered device", color="#1677c8", style="solid"];
  btscan -> btscan [label="tap Rescan", color="#1677c8", style="solid"];
}
