digraph ui_flow {
  graph [rankdir=LR, bgcolor="#0b1020", pad="0.25", nodesep="0.35", ranksep="0.65", fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#182235", color="#7dd3fc", fontcolor="#f8fafc", fontname="Arial", fontsize=11, margin="0.14,0.09"];
  edge [color="#9fb0c8", fontcolor="#dce7f5", fontname="Arial", fontsize=9, arrowsize=0.7];
  label="Wi-Fi operations and attack routes"; labelloc=t; fontsize=19; fontcolor="#ffffff";
  home [label="Transport dashboard"];
  scan [label="WiFi Scan & Attack"];
  observer [label="Network Observer"];
  net_popup [label="Network action popup"];
  client_popup [label="Client deauth popup"];
  global [label="Global WiFi Attacks"];
  deauth [label="Deauth active popup"];
  evil [label="Evil Twin setup / active"];
  sae [label="SAE Overflow active"];
  handshake [label="Handshaker popup"];
  arp [label="ARP Poison page"];
  mitm [label="MITM setup / active"];
  gitm [label="Capture Gateway page"];
  rogue_gitm [label="Rogue GITM popup"];
  nmap [label="Nmap page / result popups"];
  rogue_ap [label="Rogue AP page / popup"];
  radar [label="AP Radar"];
  sd [label="SD-card warning"];
  blackout [label="Blackout confirm / active"];
  sniffer [label="SnifferDog confirm / active"];
  global_hs [label="Global Handshaker confirm / active"];
  portal [label="Phishing Portal setup / active"];
  beacon [label="Beacon Spam menu"];
  ssids [label="Beacon SSID list / editor"];
  wardrive [label="Wardrive page / overlays"];
  home -> scan [label="tap WiFi Scan & Attack", color="#1677c8", style="solid"];
  home -> observer [label="tap Network Observer", color="#1677c8", style="solid"];
  home -> global [label="tap Global WiFi Attacks", color="#1677c8", style="solid"];
  observer -> net_popup [label="tap network row", color="#1677c8", style="solid"];
  observer -> client_popup [label="tap client row; Red Team required", color="#b26a00", style="dashed"];
  scan -> deauth [label="tap Deauth; one or more selected", color="#b26a00", style="dashed"];
  scan -> sd [label="Evil Twin without SD", color="#b26a00", style="dashed"];
  scan -> evil [label="tap Evil Twin", color="#1677c8", style="solid"];
  scan -> sae [label="tap SAE Overflow; exactly one AP", color="#b26a00", style="dashed"];
  scan -> handshake [label="tap Handshaker", color="#1677c8", style="solid"];
  scan -> arp [label="tap ARP Poison; exactly one AP", color="#b26a00", style="dashed"];
  scan -> mitm [label="tap MITM; exactly one AP", color="#b26a00", style="dashed"];
  scan -> gitm [label="tap Capture GW", color="#1677c8", style="solid"];
  scan -> rogue_gitm [label="tap Rogue GITM; exactly one AP", color="#b26a00", style="dashed"];
  scan -> nmap [label="tap Nmap; exactly one AP", color="#b26a00", style="dashed"];
  scan -> rogue_ap [label="tap Rogue AP; exactly one AP", color="#b26a00", style="dashed"];
  scan -> radar [label="tap AP Radar; exactly one AP", color="#b26a00", style="dashed"];
  global -> blackout [label="tap Blackout", color="#1677c8", style="solid"];
  global -> sniffer [label="tap SnifferDog", color="#1677c8", style="solid"];
  global -> global_hs [label="tap Handshaker", color="#1677c8", style="solid"];
  global -> sd [label="Portal / Wardrive without SD", color="#b26a00", style="dashed"];
  global -> portal [label="tap Portal", color="#1677c8", style="solid"];
  global -> wardrive [label="tap Wardrive", color="#1677c8", style="solid"];
  global -> beacon [label="tap Beacon Spam", color="#1677c8", style="solid"];
