digraph ui_flow {
  graph [rankdir=LR, bgcolor="#0b1020", pad="0.25", nodesep="0.35", ranksep="0.65", fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#182235", color="#7dd3fc", fontcolor="#f8fafc", fontname="Arial", fontsize=11, margin="0.14,0.09"];
  edge [color="#9fb0c8", fontcolor="#dce7f5", fontname="Arial", fontsize=9, arrowsize=0.7];
  label="Compromised data and PCAP analysis"; labelloc=t; fontsize=19; fontcolor="#ffffff";
  home [label="Transport dashboard"];
  hub [label="Compromised Data"];
  evil [label="Evil Twin Passwords"];
  portal [label="Portal Data"];
  hs [label="Handshake files"];
  wardrive [label="Wardrive files"];
  espshark [label="ESPShark hub"];
  remote [label="Monster PCAP captures"];
  transfer [label="Copy / sync progress popup"];
  local [label="Tab5 PCAP browser"];
  analysis [label="PCAP packet analysis"];
  packet [label="Packet detail"];
  summary [label="Capture / DNS summaries"];
  flows [label="Connections / protocols"];
  entities [label="Devices / remote endpoints"];
  health [label="Investigation / capture health"];
  map [label="Network map"];
  tools [label="Tools popup"];
  objects [label="Extracted objects"];
  delete [label="Delete / cleanup confirm"];
  home -> hub [label="tap Compromised Data", color="#1677c8", style="solid"];
  hub -> evil [label="tap Evil Twin Passwords", color="#1677c8", style="solid"];
  hub -> portal [label="tap Portal Data", color="#1677c8", style="solid"];
  hub -> hs [label="tap Handshakes", color="#1677c8", style="solid"];
  hub -> wardrive [label="tap Wardrive Files", color="#1677c8", style="solid"];
  hub -> espshark [label="tap ESPShark", color="#1677c8", style="solid"];
  espshark -> remote [label="tap Monster SD", color="#1677c8", style="solid"];
  espshark -> local [label="tap Tab5 SD", color="#1677c8", style="solid"];
  remote -> transfer [label="tap Copy / Sync", color="#1677c8", style="solid"];
  remote -> delete [label="tap Delete / Clean", color="#1677c8", style="solid"];
  local -> analysis [label="tap PCAP file", color="#1677c8", style="solid"];
  analysis -> local [label="Back releases capture", color="#7655b7", style="solid"];
  local -> espshark [label="Back with no capture open", color="#7655b7", style="solid"];
  analysis -> packet [label="tap packet row", color="#1677c8", style="solid"];
  analysis -> summary [label="tap summary / DNS", color="#1677c8", style="solid"];
  analysis -> flows [label="tap Connections", color="#1677c8", style="solid"];
  analysis -> flows [label="tap Protocols", color="#1677c8", style="solid"];
  analysis -> entities [label="tap Devices", color="#1677c8", style="solid"];
  analysis -> entities [label="tap Remote endpoints", color="#1677c8", style="solid"];
  analysis -> health [label="tap Health / Investigation", color="#1677c8", style="solid"];
  analysis -> map [label="tap Map", color="#1677c8", style="solid"];
  analysis -> tools [label="tap Tools", color="#1677c8", style="solid"];
  analysis -> objects [label="tap Objects", color="#1677c8", style="solid"];
}
