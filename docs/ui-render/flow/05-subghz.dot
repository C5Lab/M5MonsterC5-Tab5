digraph ui_flow {
  graph [rankdir=LR, bgcolor="#0b1020", pad="0.25", nodesep="0.35", ranksep="0.65", fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#182235", color="#7dd3fc", fontcolor="#f8fafc", fontname="Arial", fontsize=11, margin="0.14,0.09"];
  edge [color="#9fb0c8", fontcolor="#dce7f5", fontname="Arial", fontsize=9, arrowsize=0.7];
  label="Sub-GHz navigation and modal routes"; labelloc=t; fontsize=19; fontcolor="#ffffff";
  home [label="Transport dashboard"];
  hub [label="Sub-GHz"];
  scan [label="Quick Scan"];
  scan_cfg [label="Scanner Settings"];
  hunter [label="Hunter"];
  hunter_cfg [label="Hunter Settings"];
  listen [label="Listen"];
  listen_cfg [label="Listen Settings"];
  manage [label="SD Signals"];
  weather [label="Weather"];
  jammer [label="Sub-GHz Jammer"];
  tesla [label="Tesla"];
  settings [label="Sub-GHz Settings"];
  listen_action [label="Captured signal actions"];
  listen_leave [label="Leave with captures?"];
  tx_warn [label="Transmit warning"];
  hunter_action [label="Hunter capture actions"];
  hunter_leave [label="Leave with captures?"];
  manage_action [label="Saved signal actions"];
  rename [label="Rename text input"];
  delete [label="Delete confirmation"];
  repeat [label="Transmit count"];
  home -> hub [label="tap Sub-GHz", color="#1677c8", style="solid"];
  hub -> scan [label="tap Quick Scan", color="#1677c8", style="solid"];
  hub -> hunter [label="tap Hunter", color="#1677c8", style="solid"];
  hub -> listen [label="tap Listen", color="#1677c8", style="solid"];
  hub -> manage [label="tap SD Signals", color="#1677c8", style="solid"];
  hub -> weather [label="tap Weather", color="#1677c8", style="solid"];
  hub -> jammer [label="tap Jammer", color="#1677c8", style="solid"];
  hub -> tesla [label="tap Tesla", color="#1677c8", style="solid"];
  hub -> settings [label="tap Settings", color="#1677c8", style="solid"];
  scan -> scan_cfg [label="tap Settings", color="#1677c8", style="solid"];
  scan_cfg -> scan [label="Back", color="#7655b7", style="solid"];
  scan -> listen [label="tap result; prefill + auto-start", color="#b26a00", style="dashed"];
  hunter -> hunter_cfg [label="tap Settings", color="#1677c8", style="solid"];
  hunter_cfg -> hunter [label="Back; resume captures", color="#7655b7", style="solid"];
  listen -> listen_cfg [label="tap Settings", color="#1677c8", style="solid"];
  listen_cfg -> listen [label="Back", color="#7655b7", style="solid"];
  listen -> listen_action [label="tap captured signal", color="#1677c8", style="solid"];
  listen -> listen_leave [label="Back with unsaved captures", color="#b26a00", style="dashed"];
  listen_action -> tx_warn [label="tap Transmit", color="#1677c8", style="solid"];
  hunter -> hunter_action [label="tap captured signal", color="#1677c8", style="solid"];
  hunter -> hunter_leave [label="Back with captures", color="#b26a00", style="dashed"];
  manage -> manage_action [label="tap saved signal", color="#1677c8", style="solid"];
  manage_action -> rename [label="tap Rename", color="#1677c8", style="solid"];
  manage_action -> delete [label="tap Delete", color="#1677c8", style="solid"];
  manage_action -> repeat [label="tap Transmit", color="#1677c8", style="solid"];
  scan -> hub [label="Back", color="#7655b7", style="solid"];
  hunter -> hub [label="Back / confirmed leave", color="#7655b7", style="solid"];
  listen -> hub [label="Back / confirmed leave", color="#7655b7", style="solid"];
  manage -> hub [label="Back", color="#7655b7", style="solid"];
}
